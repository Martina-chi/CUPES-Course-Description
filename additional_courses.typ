#import "template.typ": course

= Additional Sport, Society and Education Courses

#course(
  name: [Olympic Education (Bilingual)],
  id: [XS04B3008],
  credit: [2],
  hours: [36],
  content: [
    - International Olympic education concepts and organizations
    - Educational content of Olympic education
    - Practical pathways for Olympic education
    - Olympic education in school physical education
    - Curriculum design for youth sport clubs
  ],
  description: [
    This course examines the universal values of Olympic education and their localized application in Chinese schools and youth sport clubs. It introduces international Olympic education concepts and organizations, educational content and practical pathways, and applies these foundations to school physical education design and youth sport club curriculum design.
  ],
)

#course(
  name: [Social Psychology in Recreational Sports],
  id: [XS043004],
  credit: [2],
  hours: [36],
  content: [
    - Foundations and historical development of social psychology in leisure
    - Research methods in social psychology of leisure
    - Leisure experiences, needs and motivations
    - Personality, attitudes and leisure identity
    - Individual differences in leisure behavior and experience
    - Optimization of leisure outcomes
    - Leisure experiences in adulthood and later life
  ],
  description: [
    This course introduces social psychological approaches to leisure and recreational sport. It covers the historical development and research methods of leisure social psychology, leisure experience, needs and motivation, personality, attitudes and leisure identity, and factors influencing leisure behavior and experience across different stages of adulthood.
  ],
)

#course(
  name: [Education],
  id: [XS043005],
  credit: [2],
  hours: [36],
  content: [
    - Objects and research methods of education
    - Historical development of education
    - Relationships between education, individuals and society
    - Educational aims and school systems
    - Curriculum and teaching
    - Teachers, moral education and aesthetic education
    - School management
  ],
  description: [
    This course introduces the research objects, research methods, fundamental concepts, principles and regularities of education. Major topics include the historical development of education, relationships between education, individuals and society, educational aims, school systems, curriculum, teaching, teachers, moral and aesthetic education, and school management. The course connects educational theory with teaching practice.
  ],
)

#course(
  name: [Introduction to Sport and Physical Education],
  id: [XS041011],
  credit: [2],
  hours: [32],
  content: [
    - Historical development of sport in China and the West
    - Concepts, functions and potential distortions of sport
    - Sport systems and governance structures
    - School sport, competitive sport and social sport
    - Sport industry
    - Development of the Olympic Movement and its relationship with China
  ],
  description: [
    This course examines sport from historical, theoretical, comparative and international perspectives. It addresses the historical evolution of sport in China and the West, fundamental concepts and functions of sport, sport systems, school sport, competitive sport, social sport and the sport industry, as well as the development of the Olympic Movement and its relationship with China.
  ],
)

= Fitness, Exercise and Applied Sport Science

#course(
  name: [Guide on Fitness Training],
  id: [XS043025],
  credit: [4],
  hours: [72],
  content: [
    - Definitions, classifications and assessment indicators of health
    - Basic sport science for fitness exercise
    - Fitness assessment methods
    - Fitness programme and plan design
    - Fitness guidance for different population groups
    - Cardiorespiratory, flexibility, muscular and balance training
    - Exercise load control, safety, assistance and programme implementation
  ],
  description: [
    This course develops systematic knowledge and practical skills for fitness training and guidance. Students study health concepts and assessment, foundational sport science, fitness evaluation, exercise methods, programme and plan design, guidance for different populations, exercise load control, safety and practical implementation of fitness programmes.
  ],
)

#course(
  name: [Resistance Exercise],
  id: [XS043023],
  credit: [2],
  hours: [36],
  content: [
    - Physiological foundations of resistance exercise
    - Classification, characteristics and functions of resistance training
    - Resistance training techniques and methods
    - Design of resistance training programmes and plans
    - Bodyweight, small-equipment and machine-based resistance exercises
    - Resistance exercise instruction skills
  ],
  description: [
    This course introduces the physiological foundations, classifications, functions and technical methods of resistance exercise. Students learn to design resistance exercise combinations and training plans, practise bodyweight and equipment-based resistance exercises, and develop practical skills for providing resistance exercise instruction.
  ],
)

#course(
  name: [Swimming],
  id: [XS042013],
  credit: [4],
  hours: [72],
  content: [
    - Competitive swimming techniques
    - Practical swimming techniques
    - Water self-rescue skills
    - Water and natural-water safety knowledge
    - Breaststroke, backstroke and front crawl
    - Treading water, underwater swimming, elementary backstroke and sidestroke
  ],
  description: [
    This course develops swimming technique, water-safety knowledge and practical aquatic skills. Students learn competitive and practical swimming techniques, water self-rescue and basic rescue knowledge while developing cardiorespiratory fitness, muscular endurance and the ability to participate safely in aquatic activities.
  ],
)

#course(
  name: [Tennis],
  id: [XS042014],
  credit: [2],
  hours: [32],
  content: [
    - Fundamental tennis theory
    - Basic tennis techniques and tactics
    - Competition rules
    - Competition organization and scheduling
  ],
  description: [
    This course introduces the basic theories, techniques, tactics and competition organization of tennis. It develops an understanding of tennis as a sport and provides foundational knowledge for participation, promotion, instruction and the organization of tennis activities and competitions.
  ],
)

#course(
  name: [Badminton],
  id: [XS042015],
  credit: [2],
  hours: [32],
  content: [
    - Origins and development of badminton
    - Sport etiquette and rules
    - Fundamental badminton techniques and tactics
    - Principles of badminton participation and instruction
    - Application to sport-for-all fitness guidance
  ],
  description: [
    This course combines theoretical and practical study of badminton. It introduces the origins and development of the sport, etiquette and rules, and fundamental technical and tactical knowledge. Practical instruction develops students' understanding of badminton and their capacity to support sport-for-all participation and guidance.
  ],
)

