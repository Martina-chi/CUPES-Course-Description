  credit: [20],
  hours: [360],
  content: [
    - Tennis theory and sport-specific knowledge
    - Tennis techniques and tactics
    - Competition rules and officiating
    - Competition organization and scheduling
    - Tennis teaching and training
    - Development of sport-specific practical competence
  ],
