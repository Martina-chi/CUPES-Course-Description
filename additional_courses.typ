#import "template.typ": course

= Sport Studies, Society, Education and Olympic Studies

#course(
  name: [Introduction to Sport and Physical Education], id: [XS041011], credit: [2], hours: [32],
  content: [
    - Historical evolution of sport in China and the West
    - Concepts, functions and distortions of sport
    - Sport systems, school sport, competitive sport and social sport
    - Sport industry
    - Development of the Olympic Movement and its relationship with China
  ],
  description: [This course interprets sport from historical, theoretical, comparative and international perspectives. It examines the historical evolution of sport in China and the West, concepts and functions of sport, sport systems, school sport, competitive sport, social sport and the sport industry, and introduces the development of the Olympic Movement and its relationship with China.],
)

#course(
  name: [Olympic Education (Bilingual)], id: [XS04B3008], credit: [2], hours: [36],
  content: [
    - Universal values of Olympic education and their localization in China
    - International Olympic education concepts and organizations
    - Content of Olympic education
    - Practical pathways for Olympic education
    - School physical education design based on Olympic education
    - Curriculum design for youth sport clubs
  ],
  description: [This course examines the universal values of Olympic education and their localized application in Chinese schools and youth sport clubs. It introduces international Olympic education concepts and organizations, educational content and practical pathways, and applies these foundations to school physical education and youth sport club curriculum design.],
)

#course(
  name: [Social Psychology in Recreational Sports], id: [XS043004], credit: [2], hours: [36],
  content: [
    - Foundations and development of social psychology in leisure
    - Research methods in social psychology of leisure
    - Leisure experience, needs and motivation
    - Personality, attitudes and leisure identity
    - Individual differences in leisure behaviour and experience
    - Optimization of leisure outcomes
  ],
  description: [This course introduces social psychological approaches to leisure and recreational sport. It covers the development and research methods of leisure social psychology, leisure experience, needs and motivation, personality, attitudes and leisure identity, and factors influencing leisure behaviour and experience.],
)

#course(
  name: [Education], id: [XS043005], credit: [2], hours: [36],
  content: [
    - Objects and research methods of education
    - Historical development of education
    - Relationships between education, individuals and society
    - Educational aims and school systems
    - Curriculum and teaching
    - Teachers, moral education and aesthetic education
    - School management
  ],
  description: [This course introduces the research objects and research methods of education together with its fundamental concepts and principles. Major topics include the historical development of education, relationships between education, individuals and society, educational aims, school systems, curriculum, teaching and school management.],
)

